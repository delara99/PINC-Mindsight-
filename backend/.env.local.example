# 🔧 AMBIENTE DE DESENVOLVIMENTO LOCAL
# Copie este arquivo para .env.local e configure

# Database (Docker MySQL Local)
DATABASE_URL="mysql://root:senha123@localhost:3306/pincdb"

# JWT
JWT_SECRET="dev-jwt-secret-local-change-me-in-production"

# Server
PORT=3000
NODE_ENV=development

# BTG (usar sandbox ou desabilitar)
BTG_CLIENT_ID=""
BTG_CLIENT_SECRET=""
BTG_WEBHOOK_SECRET=""
BTG_ENVIRONMENT="sandbox"

# OpenAI (para futura IA)
# OPENAI_API_KEY=""

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:3001"

# ⭐ CAMADA INTERPRETATIVA AVANÇADA (TalkingTo-like)
# true = ativa análise de padrões e necessidades psicológicas
# false = mantém apenas Big Five tradicional
ENABLE_ADVANCED_INTERPRETATION="false"
